# Foundation Settings
APP_NAME=Furniture Workshop API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Production PostgreSQL Connection (Dedicated Non-Superuser)
DATABASE_URL=postgresql+asyncpg://furniture_app:change_to_strong_db_password@127.0.0.1:5432/furniture_workshop

# Frontend Connection
FRONTEND_URL=http://127.0.0.1:3000

# Security & Reverse Proxy Settings
AUTH_SECRET=change_to_cryptographically_random_secret_at_least_32_chars
TRUST_PROXY=false # Set to true ONLY after Nginx X-Forwarded-For header sanitization in Phase 19

# Central Rate Limit Policy Constants
LOGIN_RATE_LIMIT=10/15m
TRACKING_RATE_LIMIT=30/m
ORDER_CREATE_RATE_LIMIT=30/m

# Optional Cloudinary Assets Management
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
