# Foundation Settings
APP_NAME=Furniture Workshop API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL Development Credentials
DATABASE_URL=postgresql+asyncpg://furniture_user:furniture_pass@localhost:5432/furniture_db

# Frontend Connection
FRONTEND_URL=http://localhost:3000

# Future Placeholders (Leave empty or placeholders for future phases)
AUTH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
